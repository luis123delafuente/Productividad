# Copia este archivo a ".env" (en la misma carpeta backend/) y rellena los valores.
# Ver README.md en la raíz del proyecto para el paso a paso de Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# Origen desde el que se sirve el frontend. En modo consolidado (backend
# sirviendo el build de produccion, ver README) es el propio backend:
# http://localhost:8000. Si arrancas el frontend aparte con `npm run dev`
# (Vite en :5173) para desarrollo activo, cambialo temporalmente a
# http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:8000

# Ruta del fichero SQLite (relativa a backend/)
DATABASE_URL=sqlite:///./data/app.db

# Asistente de IA (secretaria personal), via Groq. Genera la clave en
# https://console.groq.com/keys (cuenta gratuita, sin tarjeta).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
