# Copia este archivo a ".env" (en la misma carpeta backend/) y rellena los valores.
# Ver README.md en la raíz del proyecto para el paso a paso de Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# Origen del frontend en desarrollo (Vite). Cambialo si usas otro puerto.
FRONTEND_ORIGIN=http://localhost:5173

# Ruta del fichero SQLite (relativa a backend/)
DATABASE_URL=sqlite:///./data/app.db

# Asistente de IA (secretaria personal), via Groq. Genera la clave en
# https://console.groq.com/keys (cuenta gratuita, sin tarjeta).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
